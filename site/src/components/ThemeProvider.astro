<script is:inline>
  // Light or dark follows the device unless the reader picked one, like the Tuvima apps.
  (() => {
    let stored;
    try { stored = localStorage.getItem('starlight-theme'); } catch {}
    const choice = stored === 'light' || stored === 'dark' ? stored : 'auto';
    const query = matchMedia('(prefers-color-scheme: dark)');
    const apply = () => {
      const current = document.documentElement.dataset.themeChoice || choice;
      document.documentElement.dataset.theme = current === 'auto' ? (query.matches ? 'dark' : 'light') : current;
    };
    document.documentElement.dataset.themeChoice = choice;
    apply();
    query.addEventListener('change', apply);
  })();
</script>
