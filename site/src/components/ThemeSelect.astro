<tuvima-theme-select>
  <label>
    <span class="sr-only">Light or dark</span>
    <select aria-label="Light or dark">
      <option value="auto">Follow my device</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </label>
</tuvima-theme-select>
<script>
  class TuvimaThemeSelect extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      if (!select) return;
      const root = document.documentElement;
      select.value = root.dataset.themeChoice || 'auto';
      select.addEventListener('change', () => {
        const choice = select.value;
        root.dataset.themeChoice = choice;
        root.dataset.theme = choice === 'auto'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : choice;
        try {
          if (choice === 'auto') localStorage.removeItem('starlight-theme');
          else localStorage.setItem('starlight-theme', choice);
        } catch {}
      });
    }
  }
  if (!customElements.get('tuvima-theme-select')) customElements.define('tuvima-theme-select', TuvimaThemeSelect);
</script>
<style>
  select { font: inherit; font-size: var(--sl-text-sm); color: var(--sl-color-text); background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-gray-4); border-radius: 6px; padding: 0.45rem; min-height: 2.75rem; }
  select:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
</style>
