---
import iconUrl from '../assets/tuvima-icon.svg?url';
import { hubContext } from '../hub';

// The Tuvima logo is the "back to the hub" button on every page, including the not-found page.
const hub = hubContext(Astro.url.pathname);
---

<a href={hub.home} class="site-title" aria-label="Tuvima documentation home">
	<img src={iconUrl} alt="" width="37" height="36" style="height:2.25rem;width:auto;max-width:none" />
	<span>Tuvima</span>
</a>

<style>
	.site-title { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--sl-color-white); }
	img { height: 2.25rem; width: auto; }
	span { font-family: Montserrat, var(--sl-font); font-weight: 600; font-size: 1.35rem; letter-spacing: 0.04em; }
</style>
