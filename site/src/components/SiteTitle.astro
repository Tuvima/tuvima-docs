---
import logo from '../assets/tuvima-logo.svg?raw';
import { hubContext } from '../hub';

// The Tuvima logo is the "back to the hub" button on every page, including the not-found page.
const hub = hubContext(Astro.url.pathname);
---

<a href={hub.home} class="site-title" aria-label="Tuvima documentation home">
	<Fragment set:html={logo} />
</a>

<style>
	.site-title { display: inline-flex; align-items: center; text-decoration: none; color: var(--sl-color-white); }
	.site-title :global(svg) { height: 1.75rem; width: auto; max-width: none; display: block; }
</style>
